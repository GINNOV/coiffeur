# Pooled Neon host. The running app reads this.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.eu-west-2.aws.neon.tech/coiffeur?sslmode=require&connect_timeout=15"

# Non-pooler host on the same branch. Prisma migrations read this.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.eu-west-2.aws.neon.tech/coiffeur?sslmode=require&connect_timeout=15"

# 4 digits. Used only by `prisma db seed` when no salon row exists.
SALON_PIN="0000"

# Long random string. Signs the coiffeur_session cookie.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional folder for reference photos. Defaults to data/photos on this computer.
# PHOTO_DIR="/absolute/path/to/photos"
