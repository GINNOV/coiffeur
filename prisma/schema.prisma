generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Salon {
  id           String        @id @default(cuid())
  pinHash      String
  pinVersion   Int           @default(1)
  stylists     Stylist[]
  clients      Client[]
  appointments Appointment[]
}

model Stylist {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name         String
  position     Int
  appointments Appointment[]

  @@unique([salonId, position])
}

model Client {
  id           String        @id @default(cuid())
  salonId      String
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  name         String
  phone        String        @default("")
  phoneDigits  String        @default("")
  note         String        @default("")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@index([salonId])
}

model Appointment {
  id              String   @id @default(cuid())
  salonId         String
  salon           Salon    @relation(fields: [salonId], references: [id], onDelete: Restrict)
  stylistId       String
  stylist         Stylist  @relation(fields: [stylistId], references: [id], onDelete: Restrict)
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  startsAt        DateTime @db.Timestamptz(3)
  durationMinutes Int
  service         String   @default("")
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([stylistId, startsAt])
  @@index([clientId])
  @@index([salonId, startsAt])
}
